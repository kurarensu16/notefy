# Frontend Convex deployment URL (generated locally by `npx convex dev`,
# or set to your production `https://<name>.convex.cloud` URL in Vercel).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Note: `NOTE_ENCRYPTION_KEY` is a backend Convex environment secret — never put it here.
# Set it via CLI:
#   npx convex env set NOTE_ENCRYPTION_KEY <32-byte-base64-key>
#   npx convex env set --prod NOTE_ENCRYPTION_KEY <32-byte-base64-key>
